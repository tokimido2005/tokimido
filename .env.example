# Copy these into Render → Environment (never commit real values).

# Postgres (Neon / Render Postgres). Without it the app uses an in-memory DB
# and loses all users and listings on every restart.
DATABASE_URL=

# Long random string (e.g. `openssl rand -base64 32`). Signs sessions and captcha.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://rabotaem.md

# Admin login (username "tokimido"). At least 12 characters.
ADMIN_PASSWORD=
# Set to 1 for ONE deploy to force-replace the admin password, then remove.
ADMIN_PASSWORD_RESET=

# Optional: separate captcha key (defaults to BETTER_AUTH_SECRET).
CAPTCHA_SECRET=

# Sample listings: off in production unless set to 1.
SEED_DEMO_JOBS=
SHOW_DEMO_JOBS=

# Optional integrations
XAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
VITE_SENTRY_DSN=
